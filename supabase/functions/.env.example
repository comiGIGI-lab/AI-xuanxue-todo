# ============================================================
# Edge Functions 环境变量示例
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为同目录下的 .env ：  cp .env.example .env
#   2. 把下面的占位符替换成你自己的真实值
#   3. 启动：  supabase functions serve
#
# ⚠️ .env 文件包含敏感密钥，切勿提交到 git（已在 .gitignore 中忽略）。
#    本 .env.example 只放占位符，可以安全提交。
# ============================================================

# Supabase 项目地址
# 本地：http://localhost:54321
# 线上：Dashboard → Project Settings → API → Project URL
SUPABASE_URL=<your_supabase_url>

# Supabase 匿名公钥（前端可公开，靠 RLS 保护）
# Dashboard → Project Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=<your_anon_key>

# Supabase 服务端密钥（拥有全部权限，⚠️ 绝对不能暴露到前端或公开仓库）
# Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>

# CREO4U 平台 API Key，用于调用 AI 模型
# creo4u.com 控制台 → 获取 API Key
CREO4U_API_KEY=<your_creO4u_api_key>

# Resend 邮件服务 API Key，用于发送订阅邮件
# resend.com → API Keys
RESEND_API_KEY=<your_resend_api_key>

# ------------------------------------------------------------
# 以下变量由 Supabase 平台自动注入，本地一般无需手动配置：
#   JWT_SECRET   —— main 函数校验 JWT 用（Supabase 托管）
#   VERIFY_JWT   —— 是否校验请求 JWT，"true" / "false"
# ------------------------------------------------------------
